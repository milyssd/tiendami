# MySQL 8 / MariaDB; único origen de configuración de conexión.
DATABASE_URL="mysql://tiendami:local_dev_only@127.0.0.1:3306/tiendami"
# URL pública exacta; HTTPS en producción, necesaria para validar Origin.
APP_URL="http://localhost:3000"
# Claves base64 de 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CODE_KEY_V1="REPLACE_WITH_RANDOM_BASE64_KEY"
CODE_ACTIVE_KEY="V1"
STORAGE_SIGNING_KEY="REPLACE_WITH_ANOTHER_RANDOM_BASE64_KEY"
# Directorio privado fuera de public; permisos de lectura solo para la aplicación.
STORAGE_ROOT="./storage/private"
# Seed: no se crea administrador si faltan estas variables.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# SMTP opcional; sin configurar no se envían mensajes ni se expone el token.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TiendaMi <tienda@example.invalid>"
# IP de proxy de confianza (Nginx en loopback). No habilitar por una cabecera de cliente.
TRUST_PROXY="false"
# ID público y URL de Umami opcionales; carga solo con consentimiento.
NEXT_PUBLIC_UMAMI_URL=""
NEXT_PUBLIC_UMAMI_ID=""

# Solo docker-compose local; no afectan la conexión de Prisma.
MYSQL_PASSWORD="REPLACE_WITH_LOCAL_DB_PASSWORD"
MYSQL_ROOT_PASSWORD="REPLACE_WITH_DIFFERENT_ROOT_PASSWORD"
